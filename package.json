{
  "name": "comfhutt-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:main": "turbo run dev --filter=@comfhutt/main",
    "dev:crux": "turbo run dev --filter=@comfhutt/crux",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "legal:check": "LEGAL_GUARD_STRICT=1 node scripts/legal-token-guard.mjs apps/crux",
    "copy:check": "node scripts/landing-copy-guard.mjs apps/crux",
    "landing:check": "node scripts/landing-acceptance.mjs",
    "design:check": "node scripts/design-system-guard.mjs apps/crux"
  },
  "devDependencies": {
    "turbo": "^2.10.8"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "js-yaml@<4": "^3.15.2",
      "js-yaml@>=4": "^4.3.2",
      "fast-uri@>=3": "^3.1.9",
      "undici@>=7": "^7.30.2",
      "brace-expansion@<2": "^1.1.21",
      "brace-expansion@>=2 <3": "^2.1.7",
      "brace-expansion@>=5": "^5.0.12",
      "source-map-js": "^1.2.2",
      "proxy-addr": "^2.0.8",
      "@modelcontextprotocol/sdk": "^1.32.2",
      "handlebars": "^4.7.10",
      "zod": "^4.6.7",
      "body-parser@>=2": "^2.4.0",
      "systeminformation": "^5.33.19",
      "form-data@<5": "^4.0.6",
      "ws@>=8 <9": "^8.21.0",
      "nanoid@<4": "^3.3.18"
    }
  }
}
